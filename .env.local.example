# Source des données : "mock" (local, JSON + localStorage, joueurs de test) ou "supabase" (vraie base)
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase > Project Settings > API Keys : Project URL + clé publique (« publishable » ou « anon »).
# Jamais la clé secrète / service_role ici.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx
